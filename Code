import re
import openpyxl

def update_policy_tracker(doc_path, sheet_path):
    # 1. Define the NIST Hierarchy/Pattern
    # Matches patterns like AC-1, CM-5, or CSF tags like PR.AC-1
    nist_pattern = r'\b([A-Z]{2,3}-\d+)\b|\b([A-Z]{2}\.[A-Z]{2}-\d+)\b'
    
    found_policies = set()

    # 2. Search the Document
    with open(doc_path, 'r') as file:
        content = file.read()
        matches = re.findall(nist_pattern, content)
        for match in matches:
            # Clean up the match from the regex groups
            policy = next(filter(None, match))
            found_policies.add(policy)

    # 3. Update the Spreadsheet
    wb = openpyxl.load_workbook(sheet_path)
    sheet = wb.active # Assuming the first sheet

    print(f"Found {len(found_policies)} policies. Updating sheet...")

    for row in sheet.iter_rows(min_row=2): # Skip header
        cell = row[0] # Assuming Policy ID is in Column A
        status_cell = row[1] # Assuming Status is in Column B
        
        if cell.value in found_policies:
            status_cell.value = "Updated/Compliant"
            print(f"Match found: {cell.value}")

    wb.save(sheet_path)
    print("Update complete.")

# Usage
# update_policy_tracker('documentation.md', 'NIST_Tracker.xlsx')

